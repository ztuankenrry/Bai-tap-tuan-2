#include <iostream>
#include <list>

using namespace std;

class QueueList {
private:
    list<int> data; 

public:
    bool isEmpty() {
        return data.empty();
    }

    void enqueue(int x) {
        data.push_back(x);
    }

    void dequeue() {
        if (isEmpty()) {
            cout << "Queue Underflow!\n";
            return;
        }
        data.pop_front();
    }

    int front() {
        if (isEmpty()) {
            cout << "Queue is empty!\n";
            return -1;
        }
        return data.front();
    }
};
